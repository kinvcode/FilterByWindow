/* Accent theme — background gradient matches NeoPushButton::Accent */

* {
    font-family: "Segoe UI", "Microsoft YaHei UI", "PingFang SC", sans-serif;
    font-size: 14px;
}

QWidget {
    color: #042f2e;
    background: transparent;
}

QMainWindow, QDialog {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #5eead4,
        stop:0.45 #2dd4bf,
        stop:1 #22d3ee);
}

QLabel {
    color: #134e4a;
    background: transparent;
}

QLabel#label {
    color: #042f2e;
    font-size: 48pt;
    font-weight: 700;
    letter-spacing: 1px;
}

QLineEdit {
    color: #042f2e;
    background-color: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(4, 47, 46, 0.22);
    border-radius: 12px;
    padding: 8px 14px;
    selection-background-color: #14b8a6;
    selection-color: #ffffff;
}

QLineEdit:hover {
    border: 1px solid #0d9488;
    background-color: rgba(255, 255, 255, 0.82);
}

QLineEdit:focus {
    border: 1px solid #0f766e;
    background-color: rgba(255, 255, 255, 0.92);
}

QGroupBox {
    color: #134e4a;
    font-weight: 600;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 14px;
    margin-top: 14px;
    padding: 16px 12px 12px 12px;
    background-color: rgba(255, 255, 255, 0.38);
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    color: #042f2e;
}

QTableWidget, QTableView {
    color: #042f2e;
    background-color: rgba(255, 255, 255, 0.62);
    alternate-background-color: rgba(255, 255, 255, 0.48);
    gridline-color: rgba(4, 47, 46, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 12px;
    outline: none;
}

QTableWidget::item, QTableView::item {
    padding: 6px 8px;
    border: none;
}

QTableWidget::item:selected, QTableView::item:selected {
    background-color: rgba(20, 184, 166, 0.35);
    color: #042f2e;
}

QHeaderView::section {
    color: #042f2e;
    background-color: rgba(255, 255, 255, 0.75);
    border: none;
    border-bottom: 1px solid #0d9488;
    padding: 8px 10px;
    font-weight: 600;
}

QScrollBar:vertical {
    background: rgba(4, 47, 46, 0.08);
    width: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: rgba(4, 47, 46, 0.28);
    min-height: 24px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(4, 47, 46, 0.45);
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: rgba(4, 47, 46, 0.08);
    height: 10px;
    margin: 0;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: rgba(4, 47, 46, 0.28);
    min-width: 24px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(4, 47, 46, 0.45);
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QCheckBox {
    spacing: 8px;
    color: #134e4a;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: none;
    background: transparent;
    image: url(:/assets/icons/checkbox_unchecked.svg);
}

QCheckBox::indicator:hover {
    image: url(:/assets/icons/checkbox_unchecked.svg);
}

QCheckBox::indicator:checked {
    image: url(:/assets/icons/checkbox_checked.svg);
}

QCheckBox::indicator:checked:hover {
    image: url(:/assets/icons/checkbox_checked.svg);
}

QCheckBox::indicator:disabled {
    image: url(:/assets/icons/checkbox_unchecked.svg);
}

QCheckBox::indicator:checked:disabled {
    image: url(:/assets/icons/checkbox_checked.svg);
}

QStatusBar {
    color: #134e4a;
    background-color: rgba(255, 255, 255, 0.35);
    border-top: 1px solid rgba(255, 255, 255, 0.55);
}

QPushButton {
    color: #042f2e;
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #2dd4bf, stop:1 #22d3ee);
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 14px;
    padding: 10px 22px;
    font-weight: 600;
}

QPushButton:hover {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #5eead4, stop:1 #67e8f9);
}

QPushButton:pressed {
    background-color: qlineargradient(
        x1:0, y1:0, x2:1, y2:1,
        stop:0 #14b8a6, stop:1 #06b6d4);
}

QPushButton:disabled {
    color: #64748b;
    background-color: rgba(255, 255, 255, 0.45);
    border: 1px solid rgba(4, 47, 46, 0.15);
}

QToolTip {
    color: #042f2e;
    background-color: rgba(255, 255, 255, 0.95);
    border: 1px solid #14b8a6;
    border-radius: 8px;
    padding: 6px 10px;
}
